  "metrics": {
    "primary": "paired geometric runtime ratio R = exp(mean(log(t_markov/t_baseline))) over common accepted solves (both Optimal and independently agreed); the pre-registered cell statistic is the median of the 5 repeats. Because the frozen timing config forbids averaging cold with warm observations, the analysis additionally reports the cold track (repeat 0) and the warm track (median of repeats 1..4) as separate estimates; all three are published and the gate is scored on the pre-registered 5-repeat median.",
    "ci": "cluster bootstrap by structural family, 10000 resamples, seed 20260929, 95% percentile interval; instance-level bootstrap reported as a sensitivity check",
    "secondary": [
      "coverage: accepted/Optimal/Feasible/TimeLimit/Unsupported/other counts per solver over the full declared denominator, including not_run_budget cells",
      "Dolan-More performance profile over the complete declared denominator with all-failed instances kept in the denominator (scripts/dolan_more_profile.py)",
      "p95 latency per solver, cold and warm tracks reported separately",
      "memory: not captured by the frozen harnesses; recorded as unassessable unless a resource wrapper is added, and never estimated",
      "disagreements: every accepted objective cross-checked against provenance reference_objective where present, otherwise against the consensus of accepted solvers at relative tolerance 1e-4; markov-cero rows additionally require its own certificate/verification flag"
    ],
    "timing_scope": "process wall clock around the solver process (frozen scope)",
    "shift_policy": "no timing shift is applied to the primary ratio; sub-millisecond cells are reported as measured and a +/-1 ms shift sensitivity is published"
  },
  "promotion_rule": {
    "source": "roadmap 3.3 + 9.3",
    "text": "upper 95% CI of the paired geometric runtime ratio < 0.80 versus a named baseline, on >= 50 held-out instances across >= 10 structurally distinct families, with no coverage regression, no false accepted result, p95/memory regressions explained, and independent replication",
    "this_campaign_can_satisfy": [
      "paired geometric ratio with CI",
      "coverage accounting",
      "Dolan-More profiles",
      "p95",
      "cold vs warm tracks"
    ],
    "this_campaign_cannot_satisfy": [
      ">=50 held-out instances: the frozen manifest defines 38 holdout records in total and 13 of them are present locally - the corpus cannot reach 50",
      "independent replication on a second machine: no second machine is available to this agent"
    ]
  },
  "gates_declared_for_scoring": {
    "3.3_niche_gate": "scored; NOT MET is an acceptable outcome",
    "9.3_promotion_rule": "scored; NOT MET is an acceptable outcome",
    "W04_repeated_solve_20pct": "scored against build_contracts/markov-cero-solve (the frozen baseline binary) on held-out instances only",
    "G4_G5": "scored only for the parts this data can support; independent reproduction is expected to remain unassessable"
  },
  "planned_stages": [
    {
      "id": "S1",
      "driver": "scripts/run_full_compare.py",
      "argv_template": "--split {holdout|tune|train} --repeat 5 --frozen-class-caps --with-osqp --workers 1 --threads 1 --out evidence/campaign-20260929/raw/compare_{split}",
      "covers": "LP (Netlib), MILP (MIPLIB + Mittelmann + domain cases), convex QP (QPLIB), OSQP added as convex-QP comparator"
    },
    {
      "id": "S2",
      "driver": "scripts/run_full_benchmark.py",
      "argv_template": "--suites netlib qplib --split holdout --repeat 5 --out-dir ...",
      "covers": "markov-cero-only repeated benchmark rows for the cheap classes; MILP suites only if budget remains"
    },
    {
      "id": "R1",
      "driver": "scripts/run_repeated_solve_holdout.py",
      "covers": "repeated-solve sequences with deterministic cost/RHS/bound changes on holdout instances, cold vs warm-basis tracks, current binary vs frozen baseline binary"
    },
    {
      "id": "R2",
      "driver": "scripts/bench_repeated_solve.py --build-dir build_wA_camp",
      "covers": "in-process cold/warm/session timing on synthetic RHS/bound sequences"
    }
  ],
  "known_deviations_and_limitations": [
    "OSQP is not part of the frozen comparator manifest; it is added here as a declared pre-registered extra, never merged into frozen evidence files",
    "independent per-incumbent primal re-verification of external solver solutions is limited to objective cross-agreement plus markov-cero's own certificate; the frozen harness does not export competitor primal vectors, so 'independent primal checks for all returned incumbents' is only partially satisfied and is reported as such",
    "peak memory is not measured by the frozen harnesses",
    "no second machine / independent reproduction is available in this campaign",
    "the full frozen corpus is 288 records of which 204 are unavailable locally; the campaign runs only the 63 present instances"
  ],
  "full_campaign_outstanding": {
    "text": "The FULL campaign remains outstanding: complete frozen corpus (download the 204 unavailable instances), full repeats under release caps, and independent reproduction",
    "roadmap_9_1_worst_case": "240 instances x 5 seeds x 3600 s x 4 MILP solvers = 4800 solver-slot hours",
    "this_campaign_fraction": "bounded by a 3 h wall clock and <=6 concurrent solver processes"
  },
  "reproduce": {
    "build": "cmake -S . -B build_wA_camp -DCMAKE_BUILD_TYPE=Release && cmake --build build_wA_camp -j8",
    "stage1": "python3 scripts/run_full_compare.py --split holdout --repeat 5 --frozen-class-caps --with-osqp --workers 1 --threads 1 --out evidence/campaign-20260929/raw/compare_holdout (then tune, then train)",
    "analysis": "python3 scripts/run_campaign_analyse.py --campaign evidence/campaign-20260929"
  },
  "interpretation_note": "Declared before running: 'never averaged with the cold row' is satisfied by publishing cold and warm separately; the 5-repeat median is the pre-registered cell statistic for the primary ratio because the freeze also requires >=5 repeats per cell."
}
